ject":"Anatomi","order":24,"question":"Aşağıdakilerden hangisi yanlıştır?","options":[{"letter":"A","text":"Döllenme ampulla tubae uterinae’da gerçekleşir"},{"letter":"B","text":"Uterus normal durumda anteversiyon ve antefleksiyon pozisyonundadır"},{"letter":"C","text":"Lig. ovarii proprium, lig. latum uteri içinde yer alır"},{"letter":"D","text":"Vagina’nın fornix anterior’u excavatio rectouterina ile yakın komşuluk yapar"},{"letter":"E","text":"Ovaryumun esas yapısını stroma ovarii oluşturur"}],"answer":{"index":3,"letter":"D","text":"Vagina’nın fornix anterior’u excavatio rectouterina ile yakın komşuluk yapar","raw":"D) Vagina’nın fornix anterior’u excavatio rectouterina ile yakın komşuluk yapar"},"explanation":"Excavatio rectouterina vagina’nın fornix posterior’u ile yakın komşudur; fornix anterior ile değil.","sourceNote":"Kullanıcı tarafından sohbet içinde paylaşılan 2025-2026 Final çıkmış soru hatırlatması.","metadata":{"examGroup":"Final","year":"2025-2026","teacher":"Anatomi Anabilim Dalı Öğretim Üyeleri","topic":"Kadın genital anatomisi","target":"TIP2FINAL.ANATOMI.PELVIS_VE_GENITAL_ - Pelvis ve genital sistem anatomisi | Pelvik organlar, genital yollar, herniler ve otonom innervasyonu ayırt eder.","target_code":"TIP2FINAL.ANATOMI.PELVIS_VE_GENITAL_","target_title":"Pelvis ve genital sistem anatomisi","target_content":"Pelvik organlar, genital yollar, herniler ve otonom innervasyonu ayırt eder.","course":"Dönem 2","sourceGroup":"Sohbet içi çıkmış soru derleme","source":"Bu sohbet içinde kullanıcı paylaşımı","status":"Tekilleştirilmiş aktif kayıt","confidence":"Orta","validation":{"protectedDbMatch":"id","protectedDbSimilarity":1.0,"kazanımMatch":{"status":"matched","score":0.833,"note":"Kazanım PDF metinleri üzerinden otomatik anahtar kelime eşleştirmesi."},"sourceMatch":{"status":"pending_drive_source_text","note":"Drive kaynak dosyaları envantere alındı; PDF ham metin çıkarımı ayrıca tamamlanmalıdır."}}}},{"id":"0a542ef01ac09c87a2e73c94","subject":"Anato