_source_text","note":"Drive kaynak dosyaları envantere alındı; PDF ham metin çıkarımı ayrıca tamamlanmalıdır."}}}},{"id":"7dcc5eb17eb1287d1e7a4330","subject":"Histoloji","order":1645,"question":"Dil için hangisi/ hangileri doğrudur?\n\nI. Küçük lenf follikülleri bulunur\nII. Müköz bezler bulunur\nIII. Mukoza epitelinin altında lamina propria yerleşmiştir\nIV. Toplam 5 tür papilla içerir","options":[{"letter":"A","text":"Yalnız I, II ve III"},{"letter":"B","text":"Yalnız I ve III"},{"letter":"C","text":"Yalnız II ve IV"},{"letter":"D","text":"Yalnız IV"},{"letter":"E","text":"I, II, III ve IV"}],"answer":{"index":0,"letter":"A","text":"Yalnız I, II ve III","raw":"A) Yalnız I, II ve III"},"metadata":{"examGroup":"2024-2025 Dönem 2, 2. Kurul Histoloji ve Embriyoloji Teorik Soruları","year":"Belirtilmemiş","teacher":"Belirtilmemiş","topic":"2024-2025 Dönem 2, 2. Kurul Histoloji ve Embriyoloji Teorik Soruları","sourceGroup":"Belirtilmemiş","sourceNo":"1","globalNo":9,"validation":{"protectedDbMatch":"id","protectedDbSimilarity":1.0,"kazanımMatch":{"status":"matched","score":0.833,"note":"Kazanım PDF metinleri üzerinden otomatik anahtar kelime eşleştirmesi."},"sourceMatch":{"status":"pending_drive_source_text","note":"Drive kaynak dosyaları envantere alındı; PDF ham metin çıkarımı ayrıca tamamlanmalıdır."}}}},{"id":"e35df37f86a1ab2bdc78a875","subject":"Histoloji","order":1646,"question":"Tükürük bezleri için hangisi/ hangileri doğrudur?\n\nI. Bileşik alveolar ekzokrin bezlerdir.\nII. Salgı yapan kısımlarda myoepitel hücreler bulunur\nIII. Bağ dokusunda fibrobast, plazmosit, lenfositler bulunur\nIV. Salgı yapan kısımlar asinus (seröz ve müköz) ve kanallar (interkalar\nkanallar, çizgili kanallar ve boşaltım kanalları) içerirler","options":[{"letter":"A","text":"Yalnız I, II ve III"},{"letter":"B","text":"Yalnız I ve III"},{"letter":"C","text":"Yalnız II ve IV"},{"letter":"D","text":"Yalnız IV"},{"letter":"E","text":"I, II, III ve IV"}],"answer":{"index":4,"letter":"E","text":"I, II, III ve IV","raw":"E) I, II, III ve IV"},"metadata":{"examGroup":"2024-2025 Dönem 2, 2. Kurul Histoloji ve Embriyoloji Teorik Soruları","year":"Belirtilmemiş","teacher":"Belirtilmemiş","topic":"2024-2025 Dönem 2, 2. Kurul Histoloji ve Embriyoloji Teorik Soruları","sourceGroup":"Belirtilmemiş","sourceNo":"2","globalNo":10,"validation":{"protectedDbMatch":"id","protectedDbSimilarity":1.0,"kazanımMatch":{"status":"matched","score":0.833,"note":"Kazanım PDF metinleri üzerinden otomatik anahtar kelime eşleştirmesi."},"sourceMatch":{"status":"pending_drive_source_text","note":"Drive kaynak dosyaları envantere alındı; PDF ham metin çıkarımı ayrıca tamamlanmalıdır."}}}},{"id":"e6b5084523273b3430c662aa","subject":"Histoloji","order":1647,"question":"Özefagus için hangisi/ hangileri doğrudur?\n\nI. Keratinsiz çok katlı yassı epitel ile döşelidir.\nII. Lamina propriasında müköz bezler bulunur\nIII. Muskularis mukozası genelde longitudinal seyirlidir\nIV. Tunika submukozasında müköz birleşik tubuloalveoler bezler bulunur","options":[{"letter":"A","text":"Yalnız I, II ve III"},{"letter":"B","text":"Yalnız I ve III"},{"letter":"C","text":"Yalnız II ve IV"},{"letter":"D","text":"Yalnız IV"},{"letter":"E","text":"I, II, III ve IV"}],"answer":{"index":4,"letter":"E","text":"I, II, III ve IV","raw":"E) I, II, III ve IV"},"metadata":{"examGroup":"2024-2025 Dönem 2, 2. Kurul Histoloji ve Embriyoloji Teorik Soruları","year":"Belirtilmemiş","teacher":"Belirtilmemiş","topic":"2024-2025 Dönem 2, 2. Kurul Histoloji ve Embriyoloji Teorik Soruları","sourceGroup":"Belirtilmemiş","sourceNo":"3","globalNo":11,"validation":{"protectedDbMatch":"id","protectedDbSimilarity":1.0,"kazanımMatch":{"status":"matched","score":0.833,"note":"Kazanım PDF metinleri üzerinden otomatik anahtar kelime eşleştirmesi."},"sourceMatch":{"status":"pending_drive_source_text","note":"Drive kaynak dosyaları envantere alındı; PDF ham metin çıkarımı ayrıca tamamlanmalıdır."}}}},{"id":"128a023473e416059c78aba1","subject":"Histoloji","order":1648,"question":"Mide epiteli için hangisi/ hangileri doğrudur?\n\nI. Basit tek katlı prizmatik epiteldir\nII. Hem salgı hem örtü epiteli özelliği gösterir\nIII. Zonula ocludens ve zonula adherens görülür\nIV. Absorbsiyon yetenekleri vardır","options":[{"letter":"A","text":"Yalnız I, II ve III"},{"letter":"B","text":"Yalnız I ve III"},{"letter":"C","text":"Yalnız II ve IV"},{"letter":"D","text":"Yalnız IV"},{"letter":"E","text":"I, II, III ve IV"}],"answer":{"index":0,"letter":"A","text":"Yalnız I, II ve III","raw":"A) Yalnız I, II ve III"},"metadata":{"examGroup":"2024-2025 Dönem 2, 2. Kurul Histoloji ve Embriyoloji Teorik Soruları","year":"Belirtilmemiş","teacher":"Belirtilmemiş","topic":"2024-2025 Dönem 2, 2. Kurul Histoloji ve Embriyoloji Teorik Soruları","sourceGroup":"Belirtilmemiş","sourceNo":"4","globalNo":12,"validation":{"protectedDbMatch":"id","protectedDbSimilarity":1.0,"kazanımMatch":{"status":"matched","score":0.833,"note":"Kazanım PDF metinleri üzerinden otomatik anahtar kelime eşleştirmesi."},"sourceMatch":{"status":"pending_drive_source_text","note":"Drive kaynak dosyaları envantere alındı; PDF ham metin çıkarımı ayrıca tamamlanmalıdır."}}}},{"id":"ad51e139a7a1bb1006122e14","subject":"Histoloji","order":1649,"question":"İnce bağırsakta yerleşmiş enterositler için hangisi/ hangileri doğrudur?\n\nI. Basit tek katlı prizmatik epiteldir\nII. Hem salgı hem örtü epiteli özelliği gösterir\nIII. Zonula ocludens ve zonula adherens görülür\nIV. Absorbsiyon yetenekleri vardır","options":[{"letter":"A","text":"Yalnız I, II ve III"},{"letter":"B","text":"Yalnız I ve III"},{"letter":"C","text":"Yalnız II ve IV"},{"letter":"D","text":"Yalnız IV"},{"letter":"E","text":"I, II, III ve IV"}],"answer":{"index":0,"letter":"A","text":"Yalnız I, II ve III","raw":"A) Yalnız I, II ve III"},"metadata":{"examGroup":"2024-2025 Dönem 2, 2. Kurul Histoloji ve Embriyoloji Teorik Soruları","year":"Belirtilmemiş","teacher":"Belirtilmemiş","topic":"2024-2025 Dönem 2, 2. Kurul Histoloji ve Embriyoloji Teorik Soruları","sourceGroup":"Belirtilmemiş","sourceNo":"5","globalNo":13,"validation":{"protectedDbMatch":"id","protectedDbSimilarity":1.0,"kazanımMatch":{"status":"matched","score":0.833,"note":"Kazanım PDF metinleri üzerinden otomatik anahtar kelime eşleştirmesi."},"sourceMatch":{"status":"pending_drive_source_text","note":"Drive kaynak dosyaları envantere alındı; PDF ham metin çıkarımı ayrıca tamamlanmalıdır."}}}},{"id":"d4671da57f8d669974cfb5ea","subject":"Histoloji","order":1650,"question":"Kalın bağırsak için verilen bilgilerden hangisi/ hangileri doğrudur?\n\nI. Myenterik pleksus bulunmaz\nII. Lamina propria’da Lieberkühn kriptaları bulunur\nIII. Submukoza bulunmaz\nIV. Epitel çizgili kenarlı prizmatik hücreler ve goblet hücrelerinden oluşur","options":[{"letter":"A","text":"Yalnız I, II ve III"},{"letter":"B","text":"Yalnız I ve III"},{"letter":"C","text":"Yalnız II ve IV"},{"letter":"D","text":"Yalnız IV"},{"letter":"E","text":"I, II, III ve IV"}],"answer":{"index":2,"letter":"C","text":"Yalnız II ve IV","raw":"C) Yalnız II ve IV"},"metadata":{"examGroup":"2024-2025 Dönem 2, 2. Kurul Histoloji ve Embriyoloji Teorik Soruları","year":"Belirtilmemiş","teacher":"Belirtilmemiş","topic":"2024-2025 Dönem 2, 2. Kurul Histoloji ve Embriyoloji Teorik Soruları","sourceGroup":"Belirtilmemiş","sourceNo":"6","globalNo":14,"validation":{"protectedDbMatch":"id","protectedDbSimilarity":1.0,"kazanımMatch":{"status":"matched","score":0.833,"note":"Kazanım PDF metinleri üzerinden otomatik anahtar kelime eşleştirmesi."},"sourceMatch":{"status":"pending_drive_source_text","note":"Drive kaynak dosyaları envantere alındı; PDF ham metin çıkarımı ayrıca tamamlanmalıdır."}}}},{"id":"318167abc7f671e1980870e3","subject":"Histoloji","order":1651,"question":"Ito hücreleri için verilen bilgilerden hangisi/ hangileri doğrudur?\n\nI. Granülsüz endoplazmik retikulum gelişmiştir\nII. Granüllü endoplazmik retikulum gelişmiştir\nIII. Mitokondri ve golgi aparatı yönünden gelişmişlerdir\nIV. α- SMA proteini salgılayarak karaciğer fibrozunda rol oynarlar","options":[{"letter":"A","text":"Yalnız I, II ve III"},{"letter":"B","text":"Yalnız I ve III"},{"letter":"C","text":"Yalnız II ve IV"},{"letter":"D","text":"Yalnız IV"},{"letter":"E","text":"I, II, III ve IV"}],"answer":{"index":2,"letter":"C","text":"Yalnız II ve IV","raw":"C) Yalnız II ve IV"},"metadata":{"examGroup":"2024-2025 Dönem 2, 2. Kurul Histoloji ve Embriyoloji Teorik Soruları","year":"Belirtilmemiş","teacher":"Belirtilmemiş","topic":"2024-2025 Dönem 2, 2. Kurul Histoloji ve Embriyoloji Teorik Soruları","sourceGroup":"Belirtilmemiş","sourceNo":"7","globalNo":15,"validation":{"protectedDbMatch":"id","protectedDbSimilarity":1.0,"kazanımMatch":{"status":"matched","score":0.833,"note":"Kazanım PDF metinleri üzerinden otomatik anahtar kelime eşleştirmesi."},"sourceMatch":{"status":"pending_drive_source_text","note":"Drive kaynak dosyaları envantere alındı; PDF ham metin çıkarımı ayrıca tamamlanmalıdır."}}}},{"id":"87cbdf391d82d0660e1e326e","subject":"Histoloji","order":1652,"question":"Karaciğer asinusu için verilen bilgilerden hangisi/ hangileri doğrudur?\n\nI. Karşı iki köşe portal alanlar, diğer iki köşe vena sentralislerden oluşur.\nII. Asinusun 1. bölgesi plazma proteinlerini aktif sentezler, glikojeni depolar\nIII. III. Bölge oksijeni en az alan bölgedir\nIV. Safra kanalı tıkanıklıklarından en önce etkilenen hücreler birinci bölgededir","options":[{"letter":"A","text":"Yalnız I, II ve III"},{"letter":"B","text":"Yalnız I ve III"},{"letter":"C","text":"Yalnız II ve IV"},{"letter":"D","text":"Yalnız IV"},{"letter":"E","text":"I, II, III ve IV"}],"answer":{"index":4,"letter":"E","text":"I, II, III ve IV","raw":"E) I, II, III ve IV"},"metadata":{"examGroup":"2024-2025 Dönem 2, 2. Kurul Histoloji ve Embriyoloji Teorik Soruları","year":"Belirtilmemiş","teacher":"Belirtilmemiş","topic":"2024-2025 Dönem 2, 2. Kurul Histoloji ve Embriyoloji Teorik Soruları","sourceGroup":"Belirtilmemiş","sourceNo":"8","globalNo":16,"validation":{"protectedDbMatch":"id","protectedDbSimilarity":1.0,"kazanımMatch":{"status":"matched","score":0.833,"note":"Kazanım PDF metinleri üzerinden otomatik anahtar kelime eşleştirmesi."},"sourceMatch":{"status":"pending_drive_source_text","note":"Drive kaynak dosyaları envantere alındı; PDF ham metin çıkarımı ayrıca tamamlanmalıdır."}}}},{"id":"09c6a983695994bc21e9a47b","subject":"Histoloji","order":1653,"question":"Safra kesesi için verilen bilgilerden hangisi/ hangileri doğrudur?\n\nI. Tunika mukoza’da hücre zarında bazal katlantılar bulunur\nII. L. Propria’da lenf damarı bulunmaz\nIII. T. submukoza tabakası bulunmaz\nIV. Kesenin boyun bölgesinde mukus salgılayan tübüloalveoler bezler bulunur","options":[{"letter":"A","text":"Yalnız I, II ve III"},{"letter":"B","text":"Yalnız I ve III"},{"letter":"C","text":"Yalnız II ve IV"},{"letter":"D","text":"Yalnız IV"},{"letter":"E","text":"I, II, III ve IV"}],"answer":{"index":4,"letter":"E","text":"I, II, III ve IV","raw":"E) I, II, III ve IV"},"metadata":{"examGroup":"2024-2025 Dönem 2, 2. Kurul Histoloji ve Embriyoloji Teorik Soruları","year":"Belirtilmemiş","teacher":"Belirtilmemiş","topic":"2024-2025 Dönem 2, 2. Kurul Histoloji ve Embriyoloji Teorik Soruları","sourceGroup":"Belirtilmemiş","sourceNo":"9","globalNo":17,"validation":{"protectedDbMatch":"id","protectedDbSimilarity":1.0,"kazanımMatch":{"status":"matched","score":0.833,"note":"Kazanım PDF metinleri üzerinden otomatik anahtar kelime eşleştirmesi."},"sourceMatch":{"status":"pending_drive_source_text","note":"Drive kaynak dosyaları envantere alındı; PDF ham metin çıkarımı ayrıca tamamlanmalıdır."}}}},{"id":"90234f3f2180a54c38538d1b","subject":"Histoloji","order":1654,"question":"Ekzokrin Pankreas ile ilgili verilen bilgilerden hangisi/ hangileri doğrudur?\n\nI. Piramidal biçimli hücreler yuvarlak nukleusludur\nII. Bazal sitoplazmada Granüllü Endoplazmik retikulum fazladır\nIII. Apikal sitoplazmada zimojenik granüller bulunur\nIV. Asinar hücreleri çevreleyen miyoepitelyal hücreler bulunmaz","options":[{"letter":"A","text":"Yalnız I, II ve III"},{"letter":"B","text":"Yalnız I ve III"},{"letter":"C","text":"Yalnız II ve IV"},{"letter":"D","text":"Yalnız IV"},{"letter":"E","text":"I, II, III ve IV"}],"answer":{"index":4,"letter":"E","text":"I, II, III ve IV","raw":"E) I, II, III ve IV"},"metadata":{"examGroup":"2024-2025 Dönem 2, 2. Kurul Histoloji ve Embriyoloji Teorik Soruları","year":"Belirtilmemiş","teacher":"Belirtilmemiş","topic":"2024-2025 Dönem 2, 2. Kurul Histoloji ve Embriyoloji Teorik Soruları","sourceGroup":"Belirtilmemiş","sourceNo":"10","globalNo":18,"validation":{"protectedDbMatch":"id","protectedDbSimilarity":1.0,"kazanımMatch":{"status":"matched","score":0.833,"note":"Kazanım PDF metinleri üzerinden otomatik anahtar kelime eşleştirmesi."},"sourceMatch":{"status":"pending_drive_source_text","note":"Drive kaynak dosyaları envantere alındı; PDF ham metin çıkarımı ayrıca tamamlanmalıdır."}}}},{"id":"df8bc2269539d18a43070f26","subject":"Histoloji","order":1655,"question":"Papilla filiformis ile ilgili olarak verilen bilgilerden hangisi yanlıştır?","options":[{"letter":"A","text":"İnsanda en fazla bulunan papilla tipidir."},{"letter":"B","text":"Yüzeyi çok katlı keratinize epitel ile döşelidir."},{"letter":"C","text":"İnce koni şekilli papillalardır."},{"letter":"D","text":"Tat cismciği içerirler."},{"letter":"E","text":"Mikroskobik papillalar içerirler."}],"answer":{"index":3,"letter":"D","text":"Tat cismciği içerirler.","raw":"D) Tat cismciği içerirler."},"metadata":{"examGroup":"Sindirim Sistemi Histolojisi - Ağız, Orofarinks, Özefagus, Mide, Bağırsak, Karaciğer, Safra Kesesi, Pankreas","year":"Belirtilmemiş","teacher":"Belirtilmemiş","topic":"Sindirim Sistemi Histolojisi - Ağız, Orofarinks, Özefagus, Mide, Bağırsak, Karaciğer, Safra Kesesi, Pankreas","target":"Dil papillalarının tiplerini ve özelliklerini sıralar","sourceGroup":"Belirtilmemiş